FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /work

RUN apt-get update && apt-get install -y --no-install-recommends \
    latexmk \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-pictures \
    texlive-science \
    texlive-lang-japanese \
    texlive-luatex \
    fonts-noto-cjk \
    ghostscript \
    ca-certificates \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' \
'#!/bin/sh' \
'set -e' \
'' \
'if [ $# -eq 0 ]; then' \
'  echo "Usage: docker run --rm -v \"$PWD:/work\" tex-pdf input.tex"' \
'  exit 1' \
'fi' \
'' \
'INPUT="$1"' \
'' \
'latexmk -pdf -interaction=nonstopmode -halt-on-error "$INPUT"' \
 > /usr/local/bin/tex2pdf \
 && chmod +x /usr/local/bin/tex2pdf

ENTRYPOINT ["tex2pdf"]